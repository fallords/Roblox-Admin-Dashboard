# Beach Avenue! Admin — environment variables
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env`. Never put secrets in NEXT_PUBLIC_* variables.

# SQLite database file used by the app, Prisma CLI, seed and admin scripts.
# Relative paths are resolved from the project root.
DATABASE_URL="file:./prisma/dev.db"

# Set to "true" ONLY when the app runs behind a reverse proxy you control that
# overwrites the X-Forwarded-For header. When false, client IPs are treated as
# unverified (they can be spoofed) and are recorded for information only.
TRUST_PROXY="false"

# --- Roblox integration (Phase 4 — not implemented yet) ---------------------
# Leave these unset. The dashboard reports the integration as "Not configured"
# and never claims live connectivity. See docs/roblox-integration.md.
# ROBLOX_UNIVERSE_ID=""
# ROBLOX_OPEN_CLOUD_API_KEY=""
